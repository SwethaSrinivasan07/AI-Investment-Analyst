ANTHROPIC_API_KEY=sk-ant-your-key-here
ALPHA_VANTAGE_API_KEY=your-key-here
SENDGRID_API_KEY=your-key-here
JWT_SECRET=your-secret-here-min-32-chars
DATABASE_URL=sqlite+aiosqlite:///./alphalens.db
CHROMA_PERSIST_PATH=./chroma_db
# FRONTEND_URL: comma-separated list of allowed origins.
# Local dev:    http://localhost:3000
# Production:   https://alphalens.pages.dev,http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Cost controls ---
# Extended thinking budget for Bull + Bear agents (tokens).
# 0 = disable thinking entirely (~$0.08/memo, dev/testing mode)
# 1024 = minimum enabled budget (~$0.18/memo, default)
# 5000 = full thinking (~$0.37/memo, use for final demo recording only)
THINKING_BUDGET=1024

# Max tool-use turns for Research Agent (each turn = one API call).
# 5 = default (4-5 tools + synthesis). 8 = richer but ~60% more expensive.
RESEARCH_MAX_TURNS=5
